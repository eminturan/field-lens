{
  "manifestVersion": 1,
  "id": "field-lens",
  "publisher": "turanemin",
  "version": "0.2.0",
  "name": "Field Lens",
  "description": "Lists work items of one type whose chosen date field falls in a date range, with selectable states and columns, exportable as CSV.",
  "public": true,
  "categories": [
    "Azure Boards"
  ],
  "tags": [
    "report",
    "work items",
    "fields",
    "csv",
    "dashboard",
    "widget"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "scopes": [
    "vso.work"
  ],
  "icons": {
    "default": "static/icon.png"
  },
  "branding": {
    "color": "#3B5BA5",
    "theme": "dark"
  },
  "content": {
    "details": {
      "path": "overview.md"
    },
    "license": {
      "path": "LICENSE"
    }
  },
  "links": {
    "repository": {
      "uri": "https://github.com/eminturan/field-lens"
    },
    "issues": {
      "uri": "https://github.com/eminturan/field-lens/issues"
    }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/eminturan/field-lens"
  },
  "contributions": [
    {
      "id": "hub",
      "type": "ms.vss-web.hub",
      "targets": [
        "ms.vss-work-web.work-hub-group"
      ],
      "properties": {
        "name": "Field Lens",
        "order": 2,
        "uri": "dist/hub/hub.html"
      }
    },
    {
      "id": "report-widget",
      "type": "ms.vss-dashboards-web.widget",
      "targets": [
        "ms.vss-dashboards-web.widget-catalog",
        ".report-widget-config"
      ],
      "properties": {
        "name": "Field Lens",
        "description": "Monthly report by any date field: summary, monthly trend, weekly chart, distribution by a field or upcoming items.",
        "catalogIconUrl": "static/icon.png",
        "uri": "dist/report-widget/report-widget.html",
        "supportedSizes": [
          {
            "rowSpan": 1,
            "columnSpan": 2
          },
          {
            "rowSpan": 2,
            "columnSpan": 2
          },
          {
            "rowSpan": 3,
            "columnSpan": 2
          },
          {
            "rowSpan": 4,
            "columnSpan": 2
          },
          {
            "rowSpan": 1,
            "columnSpan": 3
          },
          {
            "rowSpan": 2,
            "columnSpan": 3
          },
          {
            "rowSpan": 3,
            "columnSpan": 3
          },
          {
            "rowSpan": 4,
            "columnSpan": 3
          },
          {
            "rowSpan": 1,
            "columnSpan": 4
          },
          {
            "rowSpan": 2,
            "columnSpan": 4
          },
          {
            "rowSpan": 3,
            "columnSpan": 4
          },
          {
            "rowSpan": 4,
            "columnSpan": 4
          },
          {
            "rowSpan": 1,
            "columnSpan": 5
          },
          {
            "rowSpan": 2,
            "columnSpan": 5
          },
          {
            "rowSpan": 3,
            "columnSpan": 5
          },
          {
            "rowSpan": 4,
            "columnSpan": 5
          },
          {
            "rowSpan": 1,
            "columnSpan": 6
          },
          {
            "rowSpan": 2,
            "columnSpan": 6
          },
          {
            "rowSpan": 3,
            "columnSpan": 6
          },
          {
            "rowSpan": 4,
            "columnSpan": 6
          }
        ],
        "supportedScopes": [
          "project_team"
        ],
        "isNameConfigurable": true
      }
    },
    {
      "id": "report-widget-config",
      "type": "ms.vss-dashboards-web.widget-configuration",
      "targets": [
        "ms.vss-dashboards-web.widget-configuration"
      ],
      "properties": {
        "name": "Field Lens configuration",
        "description": "View, work item type, date field, states and range of the Field Lens widget.",
        "uri": "dist/report-config/report-config.html"
      }
    }
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "static",
      "addressable": true
    }
  ]
}
