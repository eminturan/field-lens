{
  "manifestVersion": 1,
  "id": "field-lens",
  "publisher": "turanemin",
  "version": "0.1.9",
  "name": "Field Lens",
  "description": "Lists work items of one type whose chosen date field falls in a date range, with selectable states and columns, exportable as CSV.",
  "public": true,
  "categories": [
    "Azure Boards"
  ],
  "tags": [
    "report",
    "work items",
    "fields",
    "csv"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "scopes": [
    "vso.work"
  ],
  "icons": {
    "default": "static/icon.png"
  },
  "branding": {
    "color": "#3B5BA5",
    "theme": "dark"
  },
  "content": {
    "details": {
      "path": "overview.md"
    },
    "license": {
      "path": "LICENSE"
    }
  },
  "links": {
    "repository": {
      "uri": "https://github.com/eminturan/field-lens"
    },
    "issues": {
      "uri": "https://github.com/eminturan/field-lens/issues"
    }
  },
  "repository": {
    "type": "git",
    "uri": "https://github.com/eminturan/field-lens"
  },
  "contributions": [
    {
      "id": "hub",
      "type": "ms.vss-web.hub",
      "targets": [
        "ms.vss-work-web.work-hub-group"
      ],
      "properties": {
        "name": "Field Lens",
        "order": 2,
        "uri": "dist/hub/hub.html"
      }
    }
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true
    },
    {
      "path": "static",
      "addressable": true
    }
  ]
}
